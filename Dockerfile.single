# Base images and uv are pinned by digest, so rebuilding a commit starts from the same
# images and uv as the build that shipped. Dependabot moves the pins (see
# .github/dependabot.yml).

# uv, copied into the backend stage
FROM ghcr.io/astral-sh/uv:0.13.0@sha256:cdc6093146eb3ff6a40107b38f008b789e050e77ad87865e381d9917da55a168 AS uv

# Stage 1: Build the React app
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS react-build

WORKDIR /app

# Copy the rest of the React app
COPY ui/ ./

# Install dependencies
RUN npm ci --ignore-scripts

# The backend is served from the same origin (nginx proxies /api to uvicorn), so
# default the API base to a relative path. This keeps every deployed environment
# (prod, staging, ...) calling its own origin instead of a hardcoded host, which
# would otherwise be baked in from a local ui/.env at build time. A build-time env
# var takes precedence over .env files in Vite. Override with --build-arg if needed.
ARG VITE_API_ENDPOINT=/api/v1
ENV VITE_API_ENDPOINT=${VITE_API_ENDPOINT}

# The Auth0 settings are compiled into the bundle. They come from these build arguments
# or, for any not passed, from ui/.env. ORD_APP_REQUIRE_AUTH0 fails the build when one is
# missing (see vite.config.ts).
ARG VITE_AUTH0_DOMAIN
ARG VITE_AUTH0_CLIENT_ID
ARG VITE_AUTH0_AUDIENCE
ARG VITE_AUTH0_ISSUER
ARG VITE_AUTH0_SCOPE

# Build the React app
RUN ORD_APP_REQUIRE_AUTH0=true npm run build

# Stage 2: Build the FastAPI backend
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1 AS fastapi-build

WORKDIR /app

RUN groupadd --gid 1001 appgroup && \
    useradd --uid 1001 --gid 1001 --create-home --shell /bin/bash appuser

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    make \
    cmake \
    libboost-dev \
    libboost-python-dev \
    python3-dev \
    libffi-dev \
    libxml2-dev \
    libxslt-dev \
    libjpeg-dev \
    zlib1g-dev \
    libpng-dev \
    libgl1 \
    libxrender1 \
    libxext6 \
    git \
    curl \
    nginx \
    supervisor \
    ntpsec-ntpdate && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /bin/

ENV UV_PROJECT_ENVIRONMENT=/usr/local \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Copy project files
COPY uv.lock pyproject.toml ./

# Install Python dependencies (production only, no dev group)
RUN uv sync --frozen --no-dev

# Copy the rest of the FastAPI app
COPY ord_app/ ./ord_app

# Copy the built React app from the previous stage
COPY --from=react-build /app/dist /var/www/html

# Copy Nginx config file
COPY nginx.conf /etc/nginx/nginx.conf

RUN mkdir -p /var/lib/nginx /var/tmp/nginx /var/log/nginx && \
    chown -R appuser:appgroup /var/lib/nginx /var/tmp/nginx /var/log/nginx /run

# Copy Supervisor config
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

RUN chown -R appuser:appgroup /app /var/www/html /etc/nginx || ls -lah /app
RUN chown -R appuser:appgroup /etc/supervisor /var/log/supervisor

COPY entrypoint_single.sh ./
RUN chmod +x ./entrypoint_single.sh

# Expose both FastAPI and Nginx ports
EXPOSE 8000 80

# Record the source commit so the deployed image is traceable to a commit. The infra
# build (ord-infrastructure) passes --build-arg GIT_COMMIT=$(git rev-parse HEAD) from
# the checkout; defaults to "unknown" for local/manual builds. Declared last so only
# this layer rebuilds per commit.
ARG GIT_COMMIT=unknown
LABEL org.opencontainers.image.revision=$GIT_COMMIT

ENTRYPOINT ["sh", "./entrypoint_single.sh"]
