# Copy to ord_app/.env. The backend reads it at startup (service_api/settings.py), and
# variables set in the environment take precedence over it. PG_DSN, PG_ALEMBIC_DSN, and
# PG_TEST_DSN default to the docker-compose Postgres on localhost:5400.

# Auth0 settings the backend verifies access tokens against.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_ISSUER=
VITE_AUTH0_ALGORITHMS=RS256

# Dev/test-only Auth0 bypass for local development and E2E; ignored unless APP_ENV is
# localhost.
# APP_ENV=localhost
# ORD_APP_E2E=true
