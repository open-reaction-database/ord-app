.git/
.idea/
.github/

.gitignore

**/__pycache__/
**/.venv/
backend/editor/docker-compose.yml

**/node_modules/

# Build outputs and test reports from local runs.
frontend/**/dist/
frontend/**/coverage/
frontend/**/playwright-report/
frontend/**/test-results/

# The viewer's backend and image. Every frontend workspace stays in the context:
# npm ci installs each one the lockfile names.
backend/viewer/
deploy/viewer/

# Local settings and the test suite stay out of the image.
backend/editor/ord_editor/.env
backend/editor/ord_editor/testdata/
**/*_test.py
**/conftest.py
